node_modules/
**/node_modules/
server/data/
# SQLite files anywhere - the real DB lives in server/data/ (ignored above), but
# running a knex/node command from the wrong directory drops a stray empty
# app.db beside it. Neither should ever be committed.
*.db
client/dist/
.env
server/.env
*.log
.DS_Store

# Spreadsheets dropped in for the one-time eRSP migration. These carry real
# prospect names and payer classes - once committed they're in history for
# good. Ignoring the pattern protects anything dropped in the repo root
# without moving files around mid-import. (The two workbooks already tracked
# before this line was added stay tracked; gitignore doesn't retroactively
# untrack anything.)
*.xlsx
