# Copy to .env and adjust. Local dev uses SQLite; production uses Postgres.
NODE_ENV=development
PORT=4000
SQLITE_FILE=./data/app.db

# Production (cloud) - set these instead of the SQLite line above:
# NODE_ENV=production
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=require

# --- Distance backfill for newly added places -------------------------------
# The incremental backfill worker (services/backfillQueue.js) fills a new
# place's road distances into the place_distance cache. It needs a routing
# provider; services/routingProvider.js picks one:
#
#   OSRM_DATA_PATH  - a local OSRM instance. Points at the BASE NAME of the
#     preprocessed dataset (osrm-extract's output is a set of
#     nebraska-latest.osrm.* sidecar files, never a bare "nebraska-latest.osrm")
#     on a mounted volume. See scripts/backfill-distances.js's header for how
#     to build it. Fastest, no per-call cost - used for local dev and any
#     deploy that ships the dataset. Requires the osrm-backend binaries too
#     (nixpacks.toml).
# OSRM_DATA_PATH=/data/nebraska-latest.osrm
#
#   MAPBOX_TOKEN  - fallback used when there's no local dataset: the Mapbox
#     Matrix API, so a plain container deploy can still backfill with nothing
#     to install or ship. Any Mapbox token with Matrix API access; the app
#     also falls back to VITE_MAPBOX_TOKEN (the client's public token) when
#     MAPBOX_TOKEN itself isn't set. A handful of new places a month stays
#     inside Mapbox's free monthly allowance.
# MAPBOX_TOKEN=pk.your_token_here
#
# With neither set, new places just queue and retry (MAX_ATTEMPTS /
# BACKOFF_MINUTES) - nothing else breaks, existing cached distances keep
# serving route generation.
