# Copy to .env and adjust. Local dev uses SQLite; production uses Postgres.
NODE_ENV=development
PORT=4000
SQLITE_FILE=./data/app.db

# Production (cloud) - set these instead of the SQLite line above:
# NODE_ENV=production
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=require

# Self-hosted OSRM (checkpoint C) - the incremental backfill worker
# (services/backfillQueue.js) needs this to auto-fill a newly added place's
# distances. Points at the BASE NAME of the preprocessed dataset on a
# mounted volume (osrm-extract's output is a set of nebraska.osrm.* sidecar
# files, never a bare "nebraska.osrm" itself) - see
# scripts/backfill-distances.js's header for how to build that dataset.
# Without this, new places simply queue and retry (backfillQueue.js's own
# MAX_ATTEMPTS/BACKOFF_MINUTES) rather than blocking anything - existing
# cached distances keep serving regardless.
# OSRM_DATA_PATH=/data/nebraska-latest.osrm
